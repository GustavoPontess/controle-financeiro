# JWT Configuration
# Minimum 32 characters, alphanumeric + special chars recommended
JWT_SECRET=your-super-secret-key-change-this-in-production-minimum-32-characters-long!
JWT_ISSUER=ControleFinanceiro
JWT_AUDIENCE=ControleFinanceiroUsers
JWT_EXPIRATION_MINUTES=60

# Password pepper (NIST SHOULD) — segredo aplicado por cima do hash Argon2id, guardado
# SEPARADO do banco (nunca no Postgres). Opcional: sem essa var, hash/verify seguem sem pepper
# (não quebra dev local). Gerar com `openssl rand -base64 48`, nunca reusar o de dev em prod.
PASSWORD_PEPPER=

# MFA encryption key (AES-256) — criptografa o secret TOTP em repouso, guardada SEPARADA do
# banco. Obrigatória APENAS se algum usuário ativar MFA (opt-in); sem ela, ativar/verificar MFA
# falha com erro claro. 32 bytes em base64 — gerar com `openssl rand -base64 32`.
MFA_ENCRYPTION_KEY=

# Database Connection
# Postgres é o único provider (SQLite removido na #114). Suba o banco com `docker compose up -d postgres`.
# Formato Npgsql (chave=valor, ; separado) — nunca uma URI tipo postgres://.
# Em host gerenciado com TLS obrigatório, acrescente: ;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=Host=localhost;Port=5432;Database=controlefinanceiro;Username=postgres;Password=postgres

# CORS Allowed Origins (comma-separated)
# Example: http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Sentry (error tracking) — opcional. Sem DSN, o Sentry fica desativado.
# Definir apenas em produção com o DSN real do projeto Sentry.
SENTRY_DSN=
