# JWT Configuration
# Minimum 32 characters, alphanumeric + special chars recommended
JWT_SECRET=your-super-secret-key-change-this-in-production-minimum-32-characters-long!
JWT_ISSUER=ControleFinanceiro
JWT_AUDIENCE=ControleFinanceiroUsers
JWT_EXPIRATION_MINUTES=60

# Database Connection
# Format: sqlite or postgres
# SQLite: Data Source=controlefinanceiro.db
# Postgres: Host=localhost;Port=5432;Database=controlefinanceiro;Username=postgres;Password=postgres
DATABASE_URL=Data Source=controlefinanceiro.db

# CORS Allowed Origins (comma-separated)
# Example: http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Environment
ASPNETCORE_ENVIRONMENT=Development
