# JWT Configuration
# Minimum 32 characters, alphanumeric + special chars recommended
JWT_SECRET=your-super-secret-key-change-this-in-production-minimum-32-characters-long!
JWT_ISSUER=ControleFinanceiro
JWT_AUDIENCE=ControleFinanceiroUsers
JWT_EXPIRATION_MINUTES=60

# Password pepper (NIST SHOULD) — segredo aplicado por cima do hash Argon2id, guardado
# SEPARADO do banco (nunca no Postgres). Opcional: sem essa var, hash/verify seguem sem pepper
# (não quebra dev local). Gerar com `openssl rand -base64 48`, nunca reusar o de dev em prod.
PASSWORD_PEPPER=

# MFA encryption key (AES-256) — criptografa o secret TOTP em repouso, guardada SEPARADA do
# banco. Obrigatória APENAS se algum usuário ativar MFA (opt-in); sem ela, ativar/verificar MFA
# falha com erro claro. 32 bytes em base64 — gerar com `openssl rand -base64 32`.
MFA_ENCRYPTION_KEY=

# Database Connection
# Postgres é o único provider (SQLite removido na #114). Suba o banco com `docker compose up -d postgres`.
# Formato Npgsql (chave=valor, ; separado) — nunca uma URI tipo postgres://.
# Em host gerenciado com TLS obrigatório, acrescente: ;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=Host=localhost;Port=5432;Database=controlefinanceiro;Username=postgres;Password=postgres

# Admin global (painel admin/beta) — e-mails que ganham a flag IsAdmin, separados por vírgula.
# É a ÚNICA via pela aplicação de tornar alguém admin (nunca por endpoint — ver AdminSeeder /
# docs/features/admin/spec.md §0). O seeder roda no boot e SÓ CONCEDE (nunca revoga; revogar é
# UPDATE manual no banco). Sem essa var, ninguém vira admin (fail-safe). O usuário precisa já ter
# se cadastrado; depois é só (re)subir a API pra a flag ser concedida.
ADMIN_EMAILS=

# Hangfire dashboard (/hangfire) — allowlist de e-mails admin, separados por vírgula (fail-closed
# sem a var). Independente do ADMIN_EMAILS acima (pode alinhar os dois se quiser).
HANGFIRE_ADMIN_EMAILS=

# CORS Allowed Origins (comma-separated)
# Example: http://localhost:5173,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "Não sou robô" (Cloudflare Turnstile) no login depois de uma senha errada, no Pedir acesso e no Esqueci a senha.
# Sem as duas fica desligado. Em dev dá pra ver funcionando com as chaves de TESTE públicas da Cloudflare (sempre passam):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# E-mail (recuperar senha, código de confirmação, aviso de exclusão). Sem SMTP_HOST nada é enviado —
# o token/código vai pro log em Development (stub). Em dev, use o Mailpit do docker-compose
# (, caixa em http://localhost:8025). Em produção, o SMTP do provedor
# (Resend, Brevo, SES…) com usuário/senha e SMTP_SECURITY=starttls.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pontes <nao-responda@localhost>
# Remetentes por tipo (opcionais; sem eles tudo sai do SMTP_FROM). Produção: seguranca@ e pontes@pontesdev.com.br.
# SMTP_FROM_SEGURANCA=Pontes <seguranca@localhost>
# SMTP_FROM_PRODUTO=Pontes <pontes@localhost>
# Reply-To dos avisos do produto (o domínio não recebe e-mail; é dado pessoal, em produção vem de secret).
# SMTP_REPLY_TO_PRODUTO=
# auto | starttls | ssl | none (Mailpit: none)
SMTP_SECURITY=none
# Raiz do front — os links dos e-mails (redefinir senha, entrar) apontam pra cá.
APP_URL=http://localhost:5174

# Senha vazada: no cadastro/troca/redefinição a senha nova é checada no Pwned Passwords (k-anonymity — só os 5
# primeiros caracteres do hash saem do servidor; timeout de 3s e, se o serviço cair, deixa passar e loga).
# "off" desliga a checagem externa (ambiente sem internet); a lista local de senhas comuns continua valendo.
SENHA_VAZADA_CHECAGEM=on

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Sentry (error tracking) — opcional. Sem DSN, o Sentry fica desativado.
# Definir apenas em produção com o DSN real do projeto Sentry.
SENTRY_DSN=
