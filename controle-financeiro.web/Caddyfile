# Servidor interno do front v2 em produção (porta 80, sem HTTPS), atrás do kamal-proxy da VPS.
# O kamal-proxy faz o HTTPS e manda /api direto pra API (config/deploy.api.yml, path_prefix); aqui chega só o front.
{
	auto_https off
	admin off
	# O kamal-proxy manda o IP real do visitante (X-Forwarded-For): confia só na rede Docker.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# CSP: só o próprio domínio + a fonte do Google (index.html) + o Turnstile da Cloudflare ("não sou robô" do login, do
		# Pedir acesso e do Esqueci a senha: script e a caixinha num iframe de challenges.cloudflare.com). O hash libera o script inline do tema do index.html
		# (scripts/conferirCspInline.mjs confere no build; mudou o script, ele diz o hash novo).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-HyuzsVspqQHR1cxYF8onSlzm9bqUEzmuMX6JeONl53g=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	root * /srv/app

	# Admin: mini-app à parte (admin.html), servido SÓ no endereço secreto ADMIN_PATH, que vem do deploy (nunca do
	# código). O app comum não tem nenhuma linha que leve pra cá; /admin cai no app como qualquer endereço que não
	# existe. Sem ADMIN_PATH o Dockerfile apaga a página e aponta pra um caminho morto. A barreira de verdade segue
	# no servidor: IsAdmin + duas etapas ligadas a cada chamada.
	@admin path {$ADMIN_PATH} {$ADMIN_PATH}/*
	handle @admin {
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /admin.html
		file_server
	}
	# O arquivo direto, nunca (senão o endereço secreto não protegeria nada).
	handle /admin.html {
		respond 404
	}

	# Cache (2026-10-26): /assets tem hash no nome (um ano, imutável); /site (fotos e prints do site) uma semana;
	# o resto (index.html e as rotas) sempre confere no servidor, pra deploy novo aparecer na hora.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@site path /site/*
	header @site Cache-Control "public, max-age=604800"
	header ?Cache-Control "no-cache"

	handle {
		try_files {path} /index.html
		file_server
	}
}
