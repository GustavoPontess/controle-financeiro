# Servidor interno do front v2 em produção (porta 80, sem HTTPS), atrás do kamal-proxy da VPS.
# O kamal-proxy faz o HTTPS e manda /api direto pra API (config/deploy.api.yml, path_prefix); aqui chega só o front.
{
	auto_https off
	admin off
	# O kamal-proxy manda o IP real do visitante (X-Forwarded-For): confia só na rede Docker.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		# CSP: só o próprio domínio + a fonte do Google (index.html).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	root * /srv/app
	try_files {path} /index.html
	file_server
}
