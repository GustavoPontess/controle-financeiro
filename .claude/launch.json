{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "controle-financeiro.web/node_modules/vite/bin/vite.js",
        "controle-financeiro.web",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd ControleFinanceiro.Api && dotnet run --launch-profile http"
      ],
      "port": 5293
    }
  ]
}
