# Variáveis lidas pelo docker-compose.yml (interpolação ${VAR}).
# Copie para `.env` (que é gitignored) e preencha. NUNCA comite o `.env` real.
#
# Em produção, defina estas variáveis no secret manager / env do host,
# não num arquivo no disco.

# Senha do Postgres. Em dev pode ser simples (localhost); em prod, forte e rotacionada.
#   gerar forte:  openssl rand -base64 24
POSTGRES_PASSWORD=postgres

# Chave de assinatura do JWT (HS256). Mínimo 32 bytes. NUNCA reutilizar entre ambientes.
# Rotacionar invalida todos os tokens emitidos (desloga todos) — esperado ao rotacionar.
#   gerar forte:  openssl rand -base64 48
JWT_SECRET=dev-secret-troque-isto-min-32-caracteres-aaaa

# Production por padrão; use Development p/ ligar o DevDataSeeder (usuário dev + dados fake).
ASPNETCORE_ENVIRONMENT=Development
